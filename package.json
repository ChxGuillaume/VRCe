{
  "name": "vrce",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite build --watch --mode development",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "generate:api-types": "npx --yes openapi-typescript@7.13.0 https://github.com/vrchatapi/specification/releases/download/v1.22.1/openapi-3.0.json -o src/types/vrchat-api.generated.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@nuxt/ui": "^4.11.3",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "material-design-icons-iconfont": "^6.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.141",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.12"
  }
}
